{
  "name": "paper-gacha",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "paper-gacha",
    "database_id": "7ca6113b-3a45-4d8d-8eb9-041364927ed7",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "BETTER_AUTH_URL": "https://paper-gacha.sora-yamada.workers.dev",
    "APP_ORIGIN": "https://paper-gacha.sora-yamada.workers.dev"
    }
}
