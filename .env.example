# Public, non-secret local Worker configuration. Copy to .dev.vars and add
# secrets there; never commit .dev.vars.
BETTER_AUTH_URL=http://localhost:8787
APP_ORIGIN=http://localhost:8787
EMAIL_FROM=Paper Gacha <noreply@example.com>
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RESET=false

# Optional public Amazon Associates tracking ID used in related-book links.
# This Vite-exposed ID is not a secret and may be left unset for regular links.
VITE_AMAZON_ASSOCIATE_TAG=
